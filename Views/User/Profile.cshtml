@model User
<h1>👤 Профиль</h1>
<div class="conteiner">
    <p class="text"><strong>Имя:@Model.Name</strong></p>
    <p class="text"><strong>Почта:@Model.Email</strong></p>
    <a href="/User/ChangePassword/@Model.Id" class="change_pas"><i class="fa fa-lock"></i> Изменить пароль</a>
    <a href="/Notes/Index" class="back_btn"><i class="fa fa-arrow-left"></i> Вернуться</a>
</div>
<style>
    body {
        font-family: 'Times New Roman', Times, serif;
        margin: 0;
        padding: 0;
        background-color: ghostwhite;
    }

    h1 {
        margin-top: 40px;
        font-size: 26px;
        font-weight: 700;
        text-align: center;
        color: #333;
        text-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

    .conteiner {
        max-width: 500px;
        margin: 30px auto;
        padding: 25px 30px;
        background-color: #f8faff; /* чуть теплее/мягче, чем azure */
        box-shadow: 0 8px 20px rgba(0,0,0,0.15); /* тень чуть больше и мягче */
        border-radius: 20px; /* чуть больше скругление */
        text-align: center;
    }

    .text {
        margin: 10px 0;
        color: #2c3e50;
        font-size: 20px;
        font-weight: 500;
    }

    .change_pas {
        width: 220px;
        display: inline-block;
        padding: 10px 15px;
        margin-top: 20px;
        text-decoration: none;
        border-radius: 8px;
        background-color: #4CAF50;
        color: white;
        font-size: 18px;
        font-weight: 500;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease-in-out;
    }

        .change_pas:hover {
            background-color: #3e8e41;
            transform: scale(1.1);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }

    .back_btn {
        width: 220px;
        display: inline-block;
        padding: 10px 15px;
        margin-top: 10px; /* чуть ниже другой кнопки */
        text-decoration: none;
        border-radius: 8px;
        background-color: #ccc; /* серый, чтобы отличать от зеленой кнопки */
        color: #333;
        font-size: 18px;
        font-weight: 500;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease-in-out;
    }

        .back_btn:hover {
            background-color: #999;
            transform: scale(1.05);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }
</style>