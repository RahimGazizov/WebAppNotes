@{
    ViewData["Title"] = "Подтверждение Email";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f5f6fa;
        margin: 0;
    }

    .confirmation-container {
        background-color: #ffffff;
        padding: 40px 50px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 500px;
        margin: 0 auto;
    }

        .confirmation-container h2 {
            color: #2f3640;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .confirmation-container p {
            color: #718093;
            font-size: 16px;
            line-height: 1.5;
            margin-bottom: 30px;
        }

        .confirmation-container .icon {
            font-size: 50px;
            color: #44bd32;
            margin-bottom: 20px;
        }

        .confirmation-container a.button {
            display: inline-block;
            text-decoration: none;
            background-color: #273c75;
            color: #ffffff;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: background-color 0.3s;
        }

            .confirmation-container a.button:hover {
                background-color: #192a56;
            }
</style>

<div class="confirmation-container">
    <div class="icon">📧</div>
    <h2>Ожидание подтверждения Email!</h2>
    <p>На ваш почтовый ящик отправлено письмо. Пожалуйста, перейдите по ссылке в письме, чтобы подтвердить свой адрес.</p>
</div>
