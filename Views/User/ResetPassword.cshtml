@model User
<h1>Сброс пароля</h1>
<div class="conteiner">
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="color:red;margin: 10px;font-size:20px;font-weight:bold;">@TempData["ErrorMessage"]</div>
    }
    <form method="post" action="ResetPassword">
        <input type="hidden" name="id" value="@Model.Id" />
        <label>Введите пароль</label>
        <input type="text" name="password" required />
        <label>Повторный пароль</label>
        <input type="text" name="confiredPassword" required />
        <button class="btn_send">Изменить пароль</button>
    </form>
</div>
<style>
    h1 {
        text-align: center;
        font-size: 22px;
        font-weight: bold;
        margin-top: 60px;
    }

    .conteiner {
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        max-width: 500px;
        margin: 15px auto;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        form input {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        form label {
            display: block;
            font-weight: bold;
            color: #555;
        }

    .btn_send {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
        background-color: #007bff;
        cursor: pointer;
        font-weight: bold;
        margin-top: 10px;
        color: white;
    }

        .btn_send:hover {
            background-color: #0056b3;
        }
</style>