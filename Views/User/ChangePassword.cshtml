@model NotesApp.ViewModels.ProfileViewModel
<h1>Изменение пароля</h1>
<div class="conteiner">
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="color:red;margin: 10px;font-size:20px;font-weight:bold;">@TempData["ErrorMessage"]</div>
    }
    <form method="post" asp-action="ChangePassword">
        <input type="hidden" asp-for="User.Id" value="@Model.User.Id" />
        <label>Введите текущий пароль</label>
        <input type="text" asp-for="Password.OldPassword" required />
        <label>Введите новый пароль</label>
        <input type="text" asp-for="Password.NewPassword" required />
        <label>Введите повторно новый пароль</label>
        <input type="text" asp-for="Password.ConfirmPassword" required />
        <button class="btn_send">Изменить пароль</button>
    </form>
    <div class="action">
        <a href="/User/GetEmail" class="btn_a">Забыли пароль?</a>
        <a href="/User/Profile" class="btn_a">Вернуться</a>
    </div>
</div>
<style>
    body {
        font-family: 'Times New Roman', Times, serif;
        margin: 0;
        padding: 0;
    }

    h1 {
        margin: 60px;
        text-align: center;
        font-size: 26px;
        font-weight: bold;
    }

    .conteiner {
        max-width: 500px;
        background-color: ghostwhite;
        border-radius: 15px;
        padding: 15px;
        margin: 0 auto;
        box-shadow: 0 6px 8px rgba(0,0,0,0.1);
    }


    form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        form input {
            width: 100%;
            border: solid 1px #ccc;
            border-radius: 5px;
            padding: 8px 12px;
            box-sizing: border-box;
        }

    label {
        display: block;
        margin-top: 15px;
        font-weight: bold;
        color: #555;
    }

    .btn_send {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
        background-color: #007bff;
        cursor: pointer;
        font-weight: bold;
        margin-top: 10px;
    }

        .btn_send:hover {
            background-color: #0056b3;
        }

    .action {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 0 10px;
    }

    .btn_a {
        color: black;
        text-decoration: none;
        font-size: 18px;
    }
</style>