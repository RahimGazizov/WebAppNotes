@model List<Notes>
@using System.Security.Claims
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}
<h1>📒 Заметки</h1>
<div class="action">
    <a href="/User/Profile/@userId" class="btn_prof">Профиль</a>
</div>
<div class="container">
    <a href="/Notes/AddNewNote" class="btn_add">➕ Добавить заметку</a>

    @if (Model.Count == 0)
    {
        <p class="empty">Заметок пока нет</p>
    }
    else
    {
        @foreach (var n in Model)
        {
            <div class="note-item">
                <p>
                    <span class="label">Заметка:</span>
                    <a href="/Notes/Edit/@n.Id" class="btn_info">@n.Title</a>
                </p>
                <form method="post" action="/Notes/Delete/@n.Id" class="delete-form" onsubmit="return confirm('вы уверены что хотите удалить?')">
                    <button type="submit" class="btn_del">🗑 Удалить</button>
                </form>
            </div>
        }
    }
</div>

<style>
    body {
        background-color: ghostwhite;
        font-family: 'Times New Roman', Times, serif;
        margin: 0;
        padding: 0;
    }

    h1 {
        font-size: 28px;
        font-weight: bold;
        text-align: center;
        margin: 50px 0 20px;
    }

    .container {
        max-width: 700px;
        margin: 0 auto;
        padding: 20px;
        border-radius: 10px;
        background-color: azure;
        box-shadow: 0 0 8px rgba(0,0,0,0.1);
    }

    .note-item {
        padding: 12px;
        border-bottom: 1px solid #ddd;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .note-item:last-child {
            border-bottom: none;
        }

    .label {
        font-weight: bold;
        margin-right: 5px;
    }

    p {
        margin: 5px 0;
        font-size: 18px;
    }

    .action {
        margin: 15px;
    }

    .btn_prof {
        width: 150px;
        display: inline-block;
        padding: 10px 15px;
        margin-top: 10px; /* чуть ниже другой кнопки */
        text-decoration: none;
        border-radius: 8px;
        background-color: #4CAF50; /* серый, чтобы отличать от зеленой кнопки */
        color: white;
        font-size: 18px;
        font-weight: 500;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease-in-out;
        text-align: center;
    }

        .btn_prof:hover {
            color: white;
            background-color: #4CAF50;
            transform: scale(1.1);
        }


    .btn_add {
        display: inline-block;
        margin-bottom: 20px;
        padding: 8px 14px;
        background: #4CAF50;
        color: white;
        border-radius: 5px;
        text-decoration: none;
        font-size: 16px;
        font-weight: bold;
    }

        .btn_add:hover {
            background: #45a049;
        }

    .btn_info {
        color: #007BFF;
        text-decoration: none;
        font-weight: bold;
    }

        .btn_info:hover {
            text-decoration: underline;
            color: #0056b3;
        }

    .btn_del {
        background: #e74c3c;
        border: none;
        color: white;
        padding: 6px 12px;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn_del:hover {
            background: #c0392b;
        }

    .empty {
        text-align: center;
        color: gray;
        font-style: italic;
        margin-top: 15px;
    }

    .delete-form {
        margin: 0;
    }
</style>
