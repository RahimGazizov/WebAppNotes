@model AuthorizationModel
<h1>Авторизация</h1>
<div class="conteiner">
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="color:red;margin: 10px;font-size:20px;font-weight:bold;">@TempData["ErrorMessage"]</div>
    }
    <form method="post" asp-action="Index">
        <label>Почта</label>
        <input type="text" asp-for="Login" required />
        <label>Пароль</label>
        <input type="text" asp-for="Password" required />
        <button type="submit" class="btn_add">Войти</button>
        <div style="text-align: center;margin-top:10px;">
            <a href="/User/Index" class="btn_not">Нет аккаунта?</a>
        </div>
    </form>
</div>
<style>
    body {
        background-color: white;
        font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    h1 {
        font-size: 29px;
        font-weight: bold;
        margin-top: 60px;
        text-align: center;
        margin-bottom: 15px;
    }

    .conteiner {
        max-width: 500px;
        background-color: ghostwhite;
        border-radius: 15px;
        padding: 15px;
        margin: 0 auto;
        box-shadow: 0 6px 8px rgba(0,0,0,0.1);
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        form input {
            width: 100%;
            border: solid 1px #ccc;
            border-radius: 5px;
            padding: 8px 12px;
            box-sizing: border-box;
        }

    label {
        display: block;
        margin-top: 15px;
        font-weight: bold;
        color: #555;
    }

    .btn_add {
        padding: 8px 12px;
        border: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
        background-color: #007bff;
        cursor: pointer;
        font-weight: bold;
        margin-top: 10px;
    }

        .btn_add:hover {
            background-color: #0056b3;
        }

    .btn_not {
        color: black;
        text-decoration: none;
    }
</style>